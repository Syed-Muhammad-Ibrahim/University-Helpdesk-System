@model HelpdeskModel.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Add Admin";
}

<div class="page-container mt-4">
    <div class="card form-card">
        <h3 class="form-title">Add New Admin</h3>
        <hr />

        <form asp-controller="Account" asp-action="RegisterAdmin" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-input" />
                    <span asp-validation-for="Name" class="validation"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-input" />
                    <span asp-validation-for="Email" class="validation"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" type="password" class="form-input" />
                    <span asp-validation-for="Password" class="validation"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-input" />
                    <span asp-validation-for="ConfirmPassword" class="validation"></span>
                </div>
            </div>

            <div class="btn-row">
                <button type="submit" class="btn-save">Create Admin</button>
                <a asp-controller="Admin" asp-action="DashBoard" class="btn-back">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
