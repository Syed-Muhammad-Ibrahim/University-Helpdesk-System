@model IEnumerable<HelpdeskModel.Models.Notice>
@{
    ViewData["Title"] = "Pending Notices";
}

<h2>Pending Notices</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Creator</th>
            <th>Department</th>
            <th>Description</th>
            <th>Created At</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var n in Model)
        {
            <tr>
                <td>@n.Id</td>
                <td>@n.CreatedBy?.FullName</td>
                <td>@n.Department?.Name</td>
                <td>@(n.Description?.Length > 40 ? n.Description.Substring(0, 40) + "..." : n.Description)</td>
                <td>@n.CreatedAt.ToString("g")</td>
                <td>
                    <form asp-action="Approve" asp-route-id="@n.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                    </form>

                    <form asp-action="Reject" asp-route-id="@n.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                    </form>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="6" class="text-center">No pending notices.</td>
        </tr>
    }
    </tbody>
</table>
