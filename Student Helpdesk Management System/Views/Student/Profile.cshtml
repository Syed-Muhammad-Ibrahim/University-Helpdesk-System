@model HelpdeskModel.ViewModels.UpdateViewModels.StudentEditViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-4">My Profile</h2>

        <dl class="row">
            <dt class="col-sm-3">Student Id</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@ViewBag.DepartmentName</dd>

            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9">@Model.Address</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.Phone</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>

        <a asp-action="EditProfile" asp-route-id="@Model.Id" class="btn btn-primary w-100">
            Edit Profile
        </a>
    </div>
</div>
