@{
    Layout = null;
    var title = ViewData["Title"] ?? "Student Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>@(ViewData["Title"] ?? "Student Dashboard")</title>
    <link rel="stylesheet" href="~/css/admin.css" />
</head>

<body>

    <div class="navbar">
        <h2>Student Dashboard</h2>
        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="dashboard">
        <div class="sidebar">
            <!-- New complain -->
            <a asp-controller="Complain" asp-action="Create">Open New Complain</a>

            <!-- My complains list -->
            <a asp-controller="Complain" asp-action="MyComplains">My Complains</a>

            <!-- Notice -->
            <a asp-controller="Notice" asp-action="Index">Notice</a>

            <!-- Student profile (existing StudentController.Profile) -->
            <a asp-controller="Student" asp-action="Profile">Profile</a>
        </div>

        <div class="content">
            @RenderBody()
        </div>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
