@model HelpdeskModel.ViewModels.ComplainViewModel
@{
    ViewData["Title"] = "Create Complain";
}

<h2>Create Complain</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label asp-for="DepartmentId"></label>
        <select asp-for="DepartmentId" class="form-control"
                asp-items="@(ViewBag.Departments as List<SelectListItem>)">
            <option value="">-- Select Department --</option>
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <!-- optional attachment -->
    <div class="form-group">
        <label>Attachment</label>
        <input type="file" name="file" class="form-control" />
        <!-- controller e file handle kore Attachment entity create kore AttachmentId set korba -->
    </div>

    <button type="submit" class="btn btn-primary">Submit</button>
    <a asp-action="MyComplains" class="btn btn-secondary">Back to list</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
