@model IEnumerable<Complain>
@{
    ViewData["Title"] = "My Complains";
}

<h2>My Complains</h2>

<a asp-action="Create" class="btn btn-success mb-3">New Complain</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Department</th>
            <th>Description</th>
            <th>Created At</th>
            <th>Status</th>
            <th>Solved?</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Department?.Name</td>
                    <td>@(item.Description?.Length > 40 ? item.Description.Substring(0, 40) + "..." : item.Description)</td>
                    <td>@item.CreatedAt.ToString("g")</td>
                    <td>@item.Status</td>
                    <td>@(item.isSolved ? "Yes" : "No")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>

                        @if (!item.isSolved)
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>

                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this complain?');">
                                    Delete
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">No complains found.</td>
            </tr>
        }
    </tbody>
</table>
