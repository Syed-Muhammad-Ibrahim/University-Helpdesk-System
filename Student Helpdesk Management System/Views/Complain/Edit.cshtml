@model HelpdeskModel.ViewModels.ComplainViewModel
@{
    ViewData["Title"] = "Edit Complain";
}

<h2>Edit Complain</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <input asp-for="Id" type="hidden" />
    <input asp-for="AttachmentId" type="hidden" />

    <div class="form-group">
        <label asp-for="DepartmentId"></label>
        <select asp-for="DepartmentId" class="form-control"
                asp-items="@(ViewBag.Departments as List<SelectListItem>)">
            <option value="">-- Select Department --</option>
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="File">Replace Attachment (optional)</label>
        <input asp-for="File" type="file" class="form-control" />
        <span asp-validation-for="File" class="text-danger"></span>

        @if (Model.AttachmentId != null)
        {
            <small class="text-muted d-block mt-1">
                An attachment already exists. Uploading a new file will replace it.
            </small>
        }
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="MyComplains" class="btn btn-secondary">Back to list</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
