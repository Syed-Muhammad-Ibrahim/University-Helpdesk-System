@{
    Layout = null;
    var title = ViewData["Title"] ?? "Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>@title</title>
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body>
    <div class="navbar">
        <h2>@title</h2>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-btn">Logout</button>
            </form>
        }
        else
        {
            <div>
                <a asp-controller="Account" asp-action="Login" class="logout-btn">Login</a>
                <a asp-controller="Account" asp-action="RegisterStudent" class="logout-btn">Register</a>
            </div>
        }
    </div>

    <div class="dashboard">
        @* Sidebar only for logged-in users *@
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <div class="sidebar">
                @* Admin links *@
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="ComplainList">View All Complaints</a>
                    <a asp-controller="Admin" asp-action="StudentList">View All Students</a>
                    <a asp-controller="Admin" asp-action="CreateStudent">Add New Student</a>
                    <a asp-controller="Admin" asp-action="StaffList">View All Staff</a>
                    <a asp-controller="Admin" asp-action="CreateStaff">Add New Staff</a>
                    <a asp-controller="Department" asp-action="Index">Department</a>
                    <a asp-controller="Notice" asp-action="AllNotice">Notice</a>
                    <a asp-controller="Notice" asp-action="Pending">Pending Notice</a>
                }

                @* Staff links *@
                @if (User.IsInRole("Staff"))
                {
                    <a asp-controller="StaffComplain" asp-action="DepartmentComplains">View All Complains</a>
                    <a asp-controller="StaffComplain" asp-action="RepliedComplains">Complains I Replied</a>
                    <a asp-controller="Notice" asp-action="Create">Create Notice</a>
                    <a asp-controller="Notice" asp-action="Index">Notices</a>
                    <a asp-controller="Notice" asp-action="MyNotices">My Notices</a>
                    <a asp-controller="Staff" asp-action="Profile">Profile</a>
                }

                @* Student links *@
                @if (User.IsInRole("Student"))
                {
                    <a asp-controller="Complain" asp-action="Create">Open New Complain</a>
                    <a asp-controller="Complain" asp-action="MyComplains">My Complains</a>
                    <a asp-controller="Notice" asp-action="Index">Notice</a>
                    <a asp-controller="Student" asp-action="Profile">Profile</a>
                }
            </div>
        }

        <div class="content">
            @RenderBody()
        </div>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
