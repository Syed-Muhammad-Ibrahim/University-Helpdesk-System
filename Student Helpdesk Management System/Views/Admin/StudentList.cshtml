@model IEnumerable<HelpdeskModel.Models.Student>

@{
    ViewData["Title"] = "All Students";
}

<div class="card">
    <h3>All Student</h3>

    @{
        var currentSearch = ViewBag.CurrentSearch as string;
        long? currentDept = ViewBag.CurrentDept as long?;
        var currentStatus = ViewBag.CurrentStatus as string;

        var departments = ViewBag.Departments as IEnumerable<HelpdeskModel.Models.Department>;
    }

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-4">
            <input type="text"
                   name="search"
                   value="@currentSearch"
                   class="form-control"
                   placeholder="Search by student id, name, email...">
        </div>

        <div class="col-md-3">
            <select name="department" class="form-select">
                <option value="">All departments</option>
                @foreach (var dept in departments)
                {
                    <option value="@dept.Id" selected="@(currentDept.HasValue && dept.Id == currentDept.Value)">
                        @dept.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">All status</option>
                <option value="active" selected="@(currentStatus == "active")">Active</option>
                <option value="inactive" selected="@(currentStatus == "inactive")">InActive</option>
                <option value="deleted" selected="@(currentStatus == "deleted")">Deleted</option>
            </select>
        </div>

        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>

        <div class="col-md-1 d-grid">
            <a asp-controller="Admin"
               asp-action="StudentList"
               class="btn btn-outline-secondary">
                Clear
            </a>
        </div>
    </form>

    <table class="table">
        <thead>
            <tr>
                <th>Student Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Phone</th>
                <th>Address</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.StudentId</td>
                    <td>@s.Name</td>
                    <td>@s.User?.Email</td>
                    <td>@s.Department?.Name</td>
                    <td>@s.Phone</td>
                    <td>@s.Address</td>
                    <td>
                        @if (s.Status == HelpdeskModel.BusinessRules.ModelStatus.Active)
                        {
                            @:Active
                        }
                        else if (s.Status == HelpdeskModel.BusinessRules.ModelStatus.Deleted)
                        {
                            @:Deleted
                        }
                        else if (s.Status == HelpdeskModel.BusinessRules.ModelStatus.InActive)
                        {
                            @:InActive
                        }
                        else
                        {
                            @s.Status.ToString()
                        }
                    </td>
                    <td>
                        <a asp-controller="Admin"
                           asp-action="EditStudent"
                           asp-route-id="@s.Id"
                           class="btn btn-sm btn-primary">
                            Edit
                        </a>

                        <form asp-controller="Admin"
                              asp-action="DeleteStudent"
                              method="post"
                              style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@s.Id" />

                            <button type="submit"
                                    class="btn btn-sm btn-danger"
                                    onclick="return confirm('Are you sure you want to soft delete this student?');"
                                    @(s.Status != HelpdeskModel.BusinessRules.ModelStatus.Active ? "disabled" : "")>
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
