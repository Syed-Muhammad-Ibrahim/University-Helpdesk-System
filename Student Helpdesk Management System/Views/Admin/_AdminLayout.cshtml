@{
    Layout = null;
    var title = ViewData["Title"] ?? "Admin Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>@(ViewData["Title"] ?? "Admin Dashboard")</title>
    <link rel="stylesheet" href="~/css/admin.css" />
</head>

<body>

    <div class="navbar">
        <h2>Admin Dashboard</h2>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="dashboard">
        <div class="sidebar">
            <a asp-controller="Complain" asp-action="Index">View All Complaints</a>
            <a asp-controller="Admin" asp-action="StudentList">View All Students</a>
            <a asp-controller="Admin" asp-action="CreateStudent">Add New Student</a>
            <a asp-controller="Admin" asp-action="StaffList">View All Staff</a>
            <a asp-controller="Admin" asp-action="CreateStaff">Add New Staff</a>
            <a asp-controller="Admin" asp-action="ComplainList">All Complains</a>
            <a asp-controller="Department" asp-action="Index">Department</a>
            <a asp-controller="Notice" asp-action="AllNotice">Notice</a>
        </div>

        <div class="content">
            @RenderBody()
        </div>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
