@model IEnumerable<HelpdeskModel.Models.Staff>

@{
    ViewData["Title"] = "All Staff";
}

<div class="card">
    <h3>All Staff</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Phone</th>
                <th>Address</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@s.User?.Email</td>
                    <td>@s.Department?.Name</td>
                    <td>@s.Phone</td>
                    <td>@s.Address</td>
                    <td>
                        @if (s.Status == HelpdeskModel.BusinessRules.ModelStatus.Active)
                        {
                            @:Active
                        }
                        else if (s.Status == HelpdeskModel.BusinessRules.ModelStatus.Deleted)
                        {
                            @:Deleted
                        }
                        else if (s.Status == HelpdeskModel.BusinessRules.ModelStatus.InActive)
                        {
                            @:InActive
                        }
                        else
                        {
                            @s.Status.ToString()
                        }
                    </td>
                    <td>
                        <a asp-controller="Admin"
                           asp-action="EditStaff"
                           asp-route-id="@s.Id"
                           class="btn btn-sm btn-primary">
                            Edit
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
