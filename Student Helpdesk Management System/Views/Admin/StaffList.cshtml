@model IEnumerable<HelpdeskModel.Models.Staff>

@{
    ViewData["Title"] = "All Staff";
    Layout = "_AdminLayout";
}

<div class="card">
    <h3>All Staff</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Phone</th>
                <th>Address</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@s.User?.Email</td>
                    <td>@s.Department?.Name</td>
                    <td>@s.Phone</td>
                    <td>@s.Address</td>
                </tr>
            }
        </tbody>
    </table>
</div>
