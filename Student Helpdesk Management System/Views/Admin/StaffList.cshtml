@model IEnumerable<HelpdeskModel.Models.Staff>

@{
    ViewData["Title"] = "All Staff";
    Layout = "_AdminLayout";
}

<div class="card">
    <h3>All Staff</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Phone</th>
                <th>Address</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@s.User?.Email</td>
                    <td>@s.Department?.Name</td>
                    <td>@s.Phone</td>
                    <td>@s.Address</td>
                    <td>
                        <a asp-controller="Admin"
                           asp-action="EditStaff"
                           asp-route-id="@s.Id"
                           class="btn btn-sm btn-primary">
                            Edit
                        </a>
                    </td>
                    <td>
                        <form asp-action="DeleteStaff" asp-controller="Admin" method="post" style="display:inline">
                            <input type="hidden" name="id" value="s.Id" />
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Are you sure you want to delete this staff?');">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }

            
        </tbody>
    </table>
</div>
