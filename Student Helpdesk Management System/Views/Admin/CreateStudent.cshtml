@model HelpdeskModel.ViewModels.StudentRegisterViewModel

@{
    ViewData["Title"] = "Add Student";
}

<div class="page-container mt-4">
    <div class="card form-card">
        <h3 class="form-title">Add New Student</h3>
        <hr />

        <form asp-controller="Admin" asp-action="CreateStudent" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-input" />
                    <span asp-validation-for="Name" class="validation"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-input" />
                    <span asp-validation-for="Email" class="validation"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" type="password" class="form-input" />
                    <span asp-validation-for="Password" class="validation"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-input" />
                    <span asp-validation-for="ConfirmPassword" class="validation"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-input" />
                    <span asp-validation-for="Address" class="validation"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-input" />
                    <span asp-validation-for="Phone" class="validation"></span>
                </div>

                <div class="col-md-12 mb-3">
                    <label asp-for="DepartmentId" class="form-label"></label>
                    <select asp-for="DepartmentId"
                            asp-items="ViewBag.Departments"
                            class="form-input">
                        <option value="">-- Select Department --</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="validation"></span>
                </div>
            </div>

            <div class="btn-row">
                <button type="submit" class="btn-save">Create Student</button>
                <a asp-controller="Admin" asp-action="DashBoard" class="btn-back">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
        await Html.RenderPartialAsync("_ValidationScriptsPartial")
}
