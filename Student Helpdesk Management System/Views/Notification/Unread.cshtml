@model List<HelpdeskModel.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
    var totalUnread = (Model == null) ? 0 : Model.Sum(x => x.UnreadCount);
}

<div class="container mt-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 class="mb-0">
            Notifications
            <span class="badge bg-primary ms-2">@totalUnread</span>
        </h3>
        <small class="text-muted">Unread</small>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No new notifications.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var n in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-start">
                    <div class="me-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="fw-bold">@n.LastMessage</div>
                            <span class="badge bg-danger">@n.UnreadCount</span>
                        </div>

                        <small class="text-muted">
                            Complaint ID: @n.ComplainId |
                            @n.LastAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                        </small>

                        <div class="mt-2">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-controller="Notification"
                               asp-action="Open"
                               asp-route-id="@n.Id">
                                Open Conversation
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
