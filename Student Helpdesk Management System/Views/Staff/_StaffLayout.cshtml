@{
    Layout = null;
    var title = ViewData["Title"] ?? "Staff Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>@(ViewData["Title"] ?? "Staff Dashboard")</title>
    <link rel="stylesheet" href="~/css/admin.css" />
</head>

<body>

    <div class="navbar">
        <h2>Staff Dashboard</h2>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="dashboard">
        <div class="sidebar">
            <a asp-controller="StaffComplain" asp-action="DepartmentComplains">View All Complains</a>
            <a asp-controller="StaffComplain" asp-action="RepliedComplains">Complains I Replied</a>
            <a asp-controller="Notice" asp-action="Index">Notice</a>
            <a asp-controller="Staff" asp-action="Profile">Profile</a>

        </div>

        <div class="content">
            @RenderBody()
        </div>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
