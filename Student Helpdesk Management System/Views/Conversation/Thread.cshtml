@model HelpdeskModel.ViewModels.Conversation.ConversationThreadViewModel

<h2>Conversation for Complain #@Model.ComplainId</h2>

<div class="mb-3">
    <p><strong>Complain:</strong> @Model.ComplainDescription</p>
    <p><strong>Status:</strong> @(Model.IsSolved ? "Solved" : "Open")</p>
</div>

<hr />

<!-- Reply box on top -->
<form asp-action="PostMessage" method="post" class="mb-4">
    @Html.AntiForgeryToken()

    <input asp-for="NewMessage.ComplainId" type="hidden" />

    <label asp-for="NewMessage.Text" class="form-label"><strong>Reply</strong></label>
    <textarea asp-for="NewMessage.Text" class="form-control" rows="3"></textarea>
    <span asp-validation-for="NewMessage.Text" class="text-danger"></span>

    <div class="d-flex gap-2 mt-2">
        <button type="submit" class="btn btn-primary">Send</button>

        <a asp-controller="@ViewBag.BackController"
           asp-action="@ViewBag.BackAction"
           class="btn btn-secondary">
            Back
        </a>
    </div>
</form>

<!-- Most recent replies on top -->
<div>
    @if (Model.Messages != null && Model.Messages.Any())
    {
        foreach (var msg in Model.Messages.OrderByDescending(m => m.CreatedAt))
        {
            <div class="mb-2">
                <strong>@msg.SenderName</strong> (@msg.CreatedAt.ToLocalTime().ToString("g")):
                <p class="mb-1">@msg.Text</p>
            </div>
            <hr />
        }
    }
    else
    {
        <p>No messages yet.</p>
    }
</div>

@section Scripts {
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
